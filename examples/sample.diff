diff --git a/payment/refund.go b/payment/refund.go
new file mode 100644
index 0000000..ce08f44
--- /dev/null
+++ b/payment/refund.go
@@ -0,0 +1,29 @@
+package payment
+
+import (
+	"context"
+	"fmt"
+)
+
+// RefundInput is one refund request against a settled payment.
+type RefundInput struct {
+	PaymentID      string
+	AmountMinor    int64
+	Currency       string
+	IdempotencyKey string
+}
+
+// Refund returns money for a payment that has already settled.
+//
+// Partial refunds are allowed; the gateway rejects anything above the
+// original amount, so no local bookkeeping is duplicated here.
+func (c *Client) Refund(ctx context.Context, in RefundInput) (Receipt, error) {
+	if in.IdempotencyKey == "" {
+		return Receipt{}, ErrMissingIdempotencyKey
+	}
+	if in.AmountMinor <= 0 {
+		return Receipt{}, fmt.Errorf("refund %s: amount must be positive", in.PaymentID)
+	}
+
+	return c.post(ctx, "/refunds", in)
+}
diff --git a/payment/tokenizer.go b/payment/token.go
similarity index 69%
rename from payment/tokenizer.go
rename to payment/token.go
index 55a4a78..0f1c3fd 100644
--- a/payment/tokenizer.go
+++ b/payment/token.go
@@ -11,15 +11,24 @@ import (
 // to the gateway, and we only ever see the token that comes back.
 type Tokenizer struct {
 	client *Client
+	cache  *TokenCache
 	ttl    time.Duration
 }
 
 // Tokenize returns the payment method ID for an initialized transaction.
+//
+// Successful responses are cached for tokenTTL: the gateway rate-limits
+// tokenization far more tightly than it does charges.
 func (t *Tokenizer) Tokenize(ctx context.Context, clientToken string) (string, error) {
+	if id, ok := t.cache.Get(clientToken); ok {
+		return id, nil
+	}
+
 	res, err := t.client.post(ctx, "/tokens", clientToken)
 	if err != nil {
 		return "", err
 	}
+	t.cache.Set(clientToken, res.MethodID, t.ttl)
 
 	return res.MethodID, nil
 }
