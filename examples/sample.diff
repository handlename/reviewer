diff --git a/payment/idempotency.go b/payment/idempotency.go
index da96fe7..8dd2646 100644
--- a/payment/idempotency.go
+++ b/payment/idempotency.go
@@ -4,20 +4,27 @@ import (
 	"context"
 	"errors"
 	"net/http"
+	"strings"
 )
 
 // ErrMissingIdempotencyKey is returned when the caller omits the header.
 var ErrMissingIdempotencyKey = errors.New("payment: missing X-Idempotency-Key")
 
-// IdempotencyKey extracts the key every charge must carry.
+// ErrMalformedIdempotencyKey is returned for a key we cannot store safely.
+var ErrMalformedIdempotencyKey = errors.New("payment: malformed X-Idempotency-Key")
+
+// IdempotencyKey extracts and validates the key every charge must carry.
 //
 // Without it a retried request charges the customer twice, which the spec
 // calls out as a [Must].
 func IdempotencyKey(ctx context.Context, req *http.Request) (string, error) {
-	key := req.Header.Get("X-Idempotency-Key")
+	key := strings.TrimSpace(req.Header.Get("X-Idempotency-Key"))
 	if key == "" {
 		return "", ErrMissingIdempotencyKey
 	}
+	if len(key) > 255 {
+		return "", ErrMalformedIdempotencyKey
+	}
 
 	return key, nil
 }
